import java.util.LinkedHashMap;
import java.util.Map;
import java.util.Scanner;

public class FirstNonRepeatingChar {

    /**
     * Finds the first character in the given string that appears only once.
     *
     * @param text The input string to check
     * @return The first non-repeating character
     * @throws IllegalArgumentException if text is null, empty, or has no non-repeating character
     */
    public static char findFirstNonRepeatingChar(String text) {
        if (text == null || text.isEmpty()) {
            throw new IllegalArgumentException("Input text cannot be null or empty.");
        }

        // Map to keep track of character frequencies while maintaining order
        Map<Character, Integer> charCountMap = new LinkedHashMap<>();

        for (char ch : text.toCharArray()) {
            charCountMap.put(ch, charCountMap.getOrDefault(ch, 0) + 1);
        }

        // Scan left to right to find the first character with a count of 1
        for (char ch : text.toCharArray()) {
            if (charCountMap.get(ch) == 1) {
                return ch;
            }
        }

        // Throw exception if no non-repeating character is found
        throw new IllegalArgumentException("No Non-Repeating Character Found");
    }

    public static void processAndDisplay(String input) {
        System.out.println("Input: \"" + input + "\"");
        try {
            char result = findFirstNonRepeatingChar(input);
            System.out.println("First Non-Repeating Character: '" + result + "'\n");
        } catch (IllegalArgumentException e) {
            System.out.println("Result: " + e.getMessage() + "\n");
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter string to test: ");
        String userInput = scanner.nextLine();
        
        System.out.println("\n=== Unique Letter Hunt Mini-Game ===");
        processAndDisplay(userInput);

        // Additional sample test cases
        System.out.println("--- Additional Test Cases ---");
        processAndDisplay("swiss");
        processAndDisplay("aabbcc");

        scanner.close();
    }
}