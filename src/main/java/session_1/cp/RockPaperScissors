import java.util.Random;
import java.util.Scanner;

public class RockPaperScissors {
    private static final String[] MOVES = {"Rock", "Paper", "Scissors"};

    public static String getComputerMove() {
        Random random = new Random();
        return MOVES[random.nextInt(MOVES.length)];
    }

    public static String playRound(String playerMove, String computerMove) {
        if (playerMove == null || computerMove == null) {
            throw new IllegalArgumentException("Moves cannot be null.");
        }

        String p = playerMove.trim().toLowerCase();
        String c = computerMove.trim().toLowerCase();

        if (!p.equals("rock") && !p.equals("paper") && !p.equals("scissors")) {
            return "Invalid Move";
        }

        if (p.equals(c)) {
            return "Draw";
        }

        if ((p.equals("rock") && c.equals("scissors")) ||
            (p.equals("paper") && c.equals("rock")) ||
            (p.equals("scissors") && c.equals("paper"))) {
            return "Player Wins";
        } else {
            return "Computer Wins";
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int totalRounds = 5;

        String[][] roundsData = new String[totalRounds][4];
        int wins = 0, losses = 0, draws = 0;

        for (int i = 0; i < totalRounds; i++) {
            System.out.print("Round " + (i + 1) + " - Enter move (Rock, Paper, Scissors): ");
            String playerMove = scanner.nextLine().trim();
            String computerMove = getComputerMove();
            String result = playRound(playerMove, computerMove);

            while (result.equals("Invalid Move")) {
                System.out.print("Invalid choice. Enter Rock, Paper, or Scissors: ");
                playerMove = scanner.nextLine().trim();
                result = playRound(playerMove, computerMove);
            }

            if (result.equals("Player Wins")) wins++;
            else if (result.equals("Computer Wins")) losses++;
            else draws++;

            roundsData[i][0] = String.valueOf(i + 1);
            roundsData[i][1] = playerMove;
            roundsData[i][2] = computerMove;
            roundsData[i][3] = result;
        }

        System.out.println("\n--- Summary Table ---");
        System.out.printf("%-8s | %-12s | %-13s | %-13s%n", "Round", "Player Move", "Computer Move", "Result");
        System.out.println("---------------------------------------------------------");
        for (String[] round : roundsData) {
            System.out.printf("%-8s | %-12s | %-13s | %-13s%n", round[0], round[1], round[2], round[3]);
        }

        double winPercentage = ((double) wins / totalRounds) * 100;
        System.out.printf("%nFinal Summary: Wins: %d | Losses: %d | Draws: %d | Win %% = %.1f%%%n",
                wins, losses, draws, winPercentage);

        scanner.close();
    }
}